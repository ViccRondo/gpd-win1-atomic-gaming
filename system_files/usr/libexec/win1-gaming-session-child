#!/usr/bin/bash
set -u

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=win1-gaming
export XDG_CURRENT_DESKTOP=Win1Gaming

systemctl --user import-environment \
    DISPLAY WAYLAND_DISPLAY XAUTHORITY \
    XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true
dbus-update-activation-environment --systemd \
    DISPLAY WAYLAND_DISPLAY XAUTHORITY \
    XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true

# The persistent user manager can retain desktop-only Plasma services from a
# maintenance session. Gaming Mode keeps KWin and services activated by Steam.
systemctl --user stop plasma-workspace.target 2>/dev/null || true
pkill -TERM -x plasmashell 2>/dev/null || true

# The internal panel is natively portrait (720x1280). Force native-density
# landscape output before Steam starts to avoid multiplying KWin/CEF scaling.
for _ in {1..20}; do
    if kscreen-doctor -j >/dev/null 2>&1; then
        kscreen-doctor output.DSI-1.enable \
            output.DSI-1.rotation.right \
            output.DSI-1.scale.1 >/dev/null 2>&1 || true
        break
    fi
    sleep 0.25
done

# 1024 frames removed underruns without the obvious latency of 2048 frames.
pw-metadata -n settings 0 clock.force-quantum 1024 >/dev/null 2>&1 || true

libexec_dir="$(cd -- "$(dirname -- "$0")" && pwd)"

cleanup() {
    if [[ -n "${power_watcher_pid:-}" ]]; then
        kill "$power_watcher_pid" 2>/dev/null || true
        wait "$power_watcher_pid" 2>/dev/null || true
    fi
    if [[ -n "${background_freezer_pid:-}" ]]; then
        kill "$background_freezer_pid" 2>/dev/null || true
        wait "$background_freezer_pid" 2>/dev/null || true
    fi
    if [[ -n "${kwin_script_loader_pid:-}" ]]; then
        kill "$kwin_script_loader_pid" 2>/dev/null || true
        wait "$kwin_script_loader_pid" 2>/dev/null || true
    fi
    pw-metadata -n settings 0 clock.force-quantum 0 >/dev/null 2>&1 || true
}
trap cleanup EXIT

load_steam_background_script() {
    for _ in {1..20}; do
        gdbus call --session \
            --dest org.kde.KWin \
            --object-path /Scripting \
            --method org.kde.kwin.Scripting.unloadScript \
            win1-steam-background >/dev/null 2>&1 || true
        if gdbus call --session \
            --dest org.kde.KWin \
            --object-path /Scripting \
            --method org.kde.kwin.Scripting.loadScript \
            "$libexec_dir/win1-steam-background.js" \
            win1-steam-background >/dev/null 2>&1; then
            gdbus call --session \
                --dest org.kde.KWin \
                --object-path /Scripting \
                --method org.kde.kwin.Scripting.start >/dev/null 2>&1 || true
            return
        fi
        sleep 0.25
    done
}

load_steam_background_script &
kwin_script_loader_pid=$!
systemctl --user stop win1-steam-background-freezer-current.service \
    >/dev/null 2>&1 || true
"$libexec_dir/win1-steam-background-freezer" &
background_freezer_pid=$!

steam_data_dir="$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
reboot_sentinel="$steam_data_dir/.steamos-reboot-sentinel"
shutdown_sentinel="$steam_data_dir/.steamos-shutdown-sentinel"
export STEAMOS_STEAM_REBOOT_SENTINEL="/var/home/$USER/.steam/steam/.steamos-reboot-sentinel"
export STEAMOS_STEAM_SHUTDOWN_SENTINEL="/var/home/$USER/.steam/steam/.steamos-shutdown-sentinel"

rm -f "$reboot_sentinel" "$shutdown_sentinel"

watch_power_requests() {
    while true; do
        if [[ -e "$reboot_sentinel" ]]; then
            rm -f "$reboot_sentinel"
            logger -t win1-gaming-session "Steam requested system reboot"
            sudo -n "$libexec_dir/win1-power-action" reboot
            return
        fi
        if [[ -e "$shutdown_sentinel" ]]; then
            rm -f "$shutdown_sentinel"
            logger -t win1-gaming-session "Steam requested system poweroff"
            sudo -n "$libexec_dir/win1-power-action" poweroff
            return
        fi
        sleep 0.2
    done
}

watch_power_requests &
power_watcher_pid=$!

flatpak run \
    --env=PATH="$HOME/.steam/steam/win1-system-bin:/app/bin:/app/utils/bin:/usr/bin" \
    com.valvesoftware.Steam \
    -gamepadui \
    -cef-use-gl=egl

if [[ -e "$reboot_sentinel" ]]; then
    rm -f "$reboot_sentinel"
    sudo -n "$(dirname -- "$0")/win1-power-action" reboot
elif [[ -e "$shutdown_sentinel" ]]; then
    rm -f "$shutdown_sentinel"
    sudo -n "$(dirname -- "$0")/win1-power-action" poweroff
fi
