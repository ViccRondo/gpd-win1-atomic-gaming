#!/usr/bin/python3
"""Open Decky's Quick Access tab with the GPD Win 1 F11 key."""

import base64
import glob
import json
import os
import pwd
import socket
import struct
import subprocess
import threading
import time
import urllib.request
from pathlib import Path


INPUT_EVENT = struct.Struct("@llHHi")
EV_KEY = 1
KEY_F11 = 87


def active_user():
    result = subprocess.run(
        ["/usr/bin/loginctl", "show-seat", "seat0", "-p", "ActiveSession", "--value"],
        check=False,
        capture_output=True,
        text=True,
    )
    session = result.stdout.strip()
    if not session:
        return None
    result = subprocess.run(
        ["/usr/bin/loginctl", "show-session", session, "-p", "User", "--value"],
        check=False,
        capture_output=True,
        text=True,
    )
    try:
        return pwd.getpwuid(int(result.stdout.strip()))
    except (KeyError, ValueError):
        return None


def keyboard_device():
    preferred = glob.glob("/dev/input/by-id/*SIPODEV*event-kbd")
    if preferred:
        return sorted(preferred)[0]
    candidates = glob.glob("/dev/input/by-id/*event-kbd")
    if len(candidates) == 1:
        return candidates[0]
    raise RuntimeError("GPD keyboard event device was not found")


def focus_window(script_name, plugin_name):
    user = active_user()
    if user is None:
        raise RuntimeError("no active seat0 user")
    script = str(Path(__file__).resolve().with_name(script_name))
    base = [
        "/usr/sbin/runuser",
        "-u",
        user.pw_name,
        "--",
        "/usr/bin/env",
        f"HOME={user.pw_dir}",
        f"XDG_RUNTIME_DIR=/run/user/{user.pw_uid}",
        f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{user.pw_uid}/bus",
        "/usr/bin/gdbus",
        "call",
        "--session",
        "--dest",
        "org.kde.KWin",
        "--object-path",
        "/Scripting",
        "--method",
    ]
    subprocess.run(
        base + ["org.kde.kwin.Scripting.unloadScript", plugin_name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    subprocess.run(
        base + ["org.kde.kwin.Scripting.loadScript", script, plugin_name],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    subprocess.run(
        base + ["org.kde.kwin.Scripting.start"],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def evaluate(title, expression):
    targets = json.load(
        urllib.request.urlopen("http://127.0.0.1:8080/json", timeout=2)
    )
    target = next(
        item for item in targets if title.lower() in item.get("title", "").lower()
    )
    path = "/" + target["webSocketDebuggerUrl"].split("/", 3)[3]
    sock = socket.create_connection(("127.0.0.1", 8080), timeout=2)
    try:
        key = base64.b64encode(os.urandom(16)).decode()
        request = (
            f"GET {path} HTTP/1.1\r\n"
            "Host: 127.0.0.1:8080\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n\r\n"
        )
        sock.sendall(request.encode())
        response = b""
        while b"\r\n\r\n" not in response:
            response += sock.recv(4096)
        if b" 101 " not in response.split(b"\r\n", 1)[0]:
            raise RuntimeError("Steam debugging connection failed")

        payload = json.dumps(
            {
                "id": 1,
                "method": "Runtime.evaluate",
                "params": {
                    "expression": expression,
                    "returnByValue": True,
                    "awaitPromise": True,
                },
            }
        ).encode()
        mask = os.urandom(4)
        header = bytearray([0x81])
        if len(payload) < 126:
            header.append(0x80 | len(payload))
        elif len(payload) < 65536:
            header.append(0x80 | 126)
            header.extend(struct.pack("!H", len(payload)))
        else:
            header.append(0x80 | 127)
            header.extend(struct.pack("!Q", len(payload)))
        header.extend(mask)
        header.extend(
            byte ^ mask[index % 4] for index, byte in enumerate(payload)
        )
        sock.sendall(header)

        while True:
            first = sock.recv(2)
            if len(first) < 2:
                raise RuntimeError("Steam debugging connection closed")
            opcode = first[0] & 0x0F
            length = first[1] & 0x7F
            if length == 126:
                length = struct.unpack("!H", sock.recv(2))[0]
            elif length == 127:
                length = struct.unpack("!Q", sock.recv(8))[0]
            data = b""
            while len(data) < length:
                data += sock.recv(length - len(data))
            if opcode != 1:
                continue
            message = json.loads(data)
            if message.get("id") == 1:
                return message.get("result", {}).get("result", {}).get("value")
    finally:
        sock.close()


def toggle_decky():
    try:
        hidden = evaluate("QuickAccess", "document.hidden")
        if hidden:
            focus_window("win1-focus-steam-qam.js", "win1-focus-steam")
            time.sleep(0.25)
        evaluate(
            "SharedJSContext",
            """
            (() => {
              if (window.__win1DeckyNavigation) return true;
              const urls = [...new Set(performance.getEntriesByType('resource')
                .map(e => e.name)
                .filter(n => n.startsWith('http://localhost:1337/frontend/') &&
                             n.includes('.js')))];
              for (const url of urls) import(url).then(m => {
                if (m?.Navigation?.OpenQuickAccessMenu && m?.QuickAccessTab)
                  window.__win1DeckyNavigation = m;
              }).catch(() => null);
              return true;
            })()
            """,
        )
        for _ in range(10):
            if evaluate(
                "SharedJSContext", "Boolean(window.__win1DeckyNavigation)"
            ):
                break
            time.sleep(0.15)
        action = (
            "window.__win1DeckyNavigation.Navigation.OpenQuickAccessMenu("
            "window.__win1DeckyNavigation.QuickAccessTab.Decky)"
            if hidden
            else "window.__win1DeckyNavigation.Navigation.CloseSideMenus()"
        )
        evaluate("SharedJSContext", action)
        if not hidden:
            time.sleep(0.15)
            focus_window("win1-focus-running-game.js", "win1-focus-game")
    except Exception as error:
        print(f"Decky shortcut failed: {error}", flush=True)


def main():
    while True:
        try:
            device_path = keyboard_device()
            print(f"Watching {device_path} for F11", flush=True)
            with open(device_path, "rb", buffering=0) as device:
                while True:
                    data = device.read(INPUT_EVENT.size)
                    if len(data) != INPUT_EVENT.size:
                        raise RuntimeError("keyboard input device disconnected")
                    _seconds, _microseconds, event_type, code, value = (
                        INPUT_EVENT.unpack(data)
                    )
                    if event_type == EV_KEY and code == KEY_F11 and value == 1:
                        threading.Thread(target=toggle_decky, daemon=True).start()
        except Exception as error:
            print(f"Decky hotkey watcher: {error}", flush=True)
            time.sleep(2)


if __name__ == "__main__":
    main()
